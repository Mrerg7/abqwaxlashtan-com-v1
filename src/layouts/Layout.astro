---
import '../styles/global.css';
import { SITE } from '../config/site';

interface Breadcrumb {
  name: string;
  path: string;
}

interface ArticleMeta {
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string | false;
  robots?: string;
  ogType?: 'website' | 'article';
  keywords?: string;
  breadcrumbs?: Breadcrumb[];
  article?: ArticleMeta;
  schemas?: Record<string, unknown>[];
}

const {
  title = `${SITE.domain} | Albuquerque Wax, Lash & Tan Domain — ${SITE.priceDisplay}`,
  description = `${SITE.domain} is the exact-match .com for Albuquerque waxing, lashes, and spray tan. Offered at ${SITE.priceDisplay} USD, escrow-protected via Escrow.com.`,
  ogImage = SITE.ogImage,
  ogType = 'website',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  keywords = SITE.keywords,
  breadcrumbs = [],
  article,
  schemas = [],
} = Astro.props;

const pathname = Astro.url.pathname;
const normalizedPath =
  pathname === '/' || pathname === '/index.html'
    ? '/'
    : pathname.endsWith('/')
      ? pathname
      : `${pathname}/`;
const canonicalUrl =
  Astro.props.canonical === false
    ? null
    : Astro.props.canonical
      ? Astro.props.canonical.startsWith('http')
        ? Astro.props.canonical
        : `${SITE.url}${Astro.props.canonical}`
      : `${SITE.url}${normalizedPath}`;

const streamPoster = `https://${SITE.streamHost}/${SITE.streamId}/thumbnails/thumbnail.jpg?time=&height=600`;
const streamManifest = `https://${SITE.streamHost}/${SITE.streamId}/manifest/video.m3u8`;
const fontsHref =
  'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap';

const breadcrumbSchema =
  breadcrumbs.length && canonicalUrl
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((crumb, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: crumb.name,
          item: crumb.path.startsWith('http') ? crumb.path : `${SITE.url}${crumb.path}`,
        })),
      }
    : null;

const articleSchema =
  ogType === 'article' && canonicalUrl
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        image: ogImage,
        datePublished: article?.publishedTime,
        dateModified: article?.modifiedTime ?? article?.publishedTime,
        author: { '@type': 'Organization', name: SITE.seller, url: SITE.url },
        publisher: {
          '@type': 'Organization',
          name: SITE.seller,
          url: SITE.url,
          logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.svg` },
        },
        mainEntityOfPage: canonicalUrl,
        keywords: keywords.split(',').map((k) => k.trim()),
        inLanguage: 'en-US',
      }
    : null;

const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: `${SITE.domain} — Albuquerque wax, lash & tan domain showcase`,
  description: `Studio atmosphere video for ${SITE.domain}, the exact-match Albuquerque wax, lash, and tan domain offered at ${SITE.priceDisplay}.`,
  thumbnailUrl: [streamPoster, ogImage],
  uploadDate: SITE.datePublished,
  contentUrl: streamManifest,
  embedUrl: SITE.url,
  publisher: { '@type': 'Organization', name: SITE.seller, url: SITE.url },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `How to buy ${SITE.domain}`,
  description: `Acquire ${SITE.domain} through an Escrow.com-protected transfer at ${SITE.priceDisplay}.`,
  totalTime: 'P5D',
  estimatedCost: {
    '@type': 'MonetaryAmount',
    currency: SITE.priceCurrency,
    value: SITE.price,
  },
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Send your inquiry',
      text: `Email ${SITE.email} with your offer, intended use, and timeline.`,
      url: `${SITE.url}/#acquisition`,
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Secure escrow',
      text: 'Funds are held by Escrow.com until both sides confirm the transfer.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Receive the domain',
      text: 'The domain pushes to your registrar account, typically within 0–5 business days of cleared payment.',
    },
  ],
};

const baseSchemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.seller,
    url: SITE.url,
    logo: `${SITE.url}/favicon.svg`,
    email: SITE.email,
    description: `Owner and seller of the ${SITE.domain} premium domain name.`,
    contactPoint: {
      '@type': 'ContactPoint',
      email: SITE.email,
      contactType: 'sales',
      availableLanguage: 'English',
      areaServed: 'US',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    alternateName: SITE.domain,
    url: SITE.url,
    description,
    inLanguage: 'en-US',
    publisher: { '@type': 'Organization', name: SITE.seller },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonicalUrl ?? SITE.url,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, caption: SITE.ogImageAlt },
    about: {
      '@type': 'Thing',
      name: 'Wax, Lash and Tan Studio Albuquerque',
      description:
        "Professional Brazilian wax, lash, and spray-tan services designed for Albuquerque's high-desert climate.",
    },
    datePublished: SITE.datePublished,
    dateModified: SITE.dateModified,
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `${SITE.domain} Premium Domain Name`,
    description: `Exact-match .com domain for Albuquerque — city code ABQ plus wax, lash, and tan in one hostname. Available for acquisition at ${SITE.priceDisplay}.`,
    url: SITE.url,
    category: 'Premium Domain Name',
    sku: SITE.domain.toLowerCase(),
    image: [ogImage],
    brand: { '@type': 'Brand', name: SITE.domain },
    offers: {
      '@type': 'Offer',
      url: `${SITE.url}/#acquisition`,
      price: SITE.price,
      priceCurrency: SITE.priceCurrency,
      availability: 'https://schema.org/InStock',
      itemCondition: 'https://schema.org/NewCondition',
      priceValidUntil: SITE.priceValidUntil,
      validFrom: SITE.datePublished,
      eligibleTransactionType: 'https://schema.org/FullPurchaseTransaction',
      seller: { '@type': 'Organization', name: SITE.seller, url: SITE.url, email: SITE.email },
      hasMerchantReturnPolicy: {
        '@type': 'MerchantReturnPolicy',
        applicableCountry: 'US',
        returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
      },
      shippingDetails: {
        '@type': 'OfferShippingDetails',
        shippingRate: { '@type': 'MonetaryAmount', value: 0, currency: SITE.priceCurrency },
        shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'US' },
        deliveryTime: {
          '@type': 'ShippingDeliveryTime',
          handlingTime: {
            '@type': 'QuantitativeValue',
            minValue: 0,
            maxValue: 5,
            unitCode: 'DAY',
          },
          transitTime: {
            '@type': 'QuantitativeValue',
            minValue: 0,
            maxValue: 0,
            unitCode: 'DAY',
          },
        },
      },
    },
  },
  videoSchema,
  howToSchema,
];

const allSchemas = [
  ...baseSchemas,
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ...(articleSchema ? [articleSchema] : []),
  ...schemas,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robots} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    <meta name="author" content={SITE.seller} />
    <meta name="format-detection" content="telephone=no" />
    {canonicalUrl && <link rel="alternate" hreflang="en" href={canonicalUrl} />}
    {canonicalUrl && <link rel="alternate" hreflang="x-default" href={canonicalUrl} />}

    <meta property="og:type" content={ogType} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={SITE.ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    {ogType === 'article' && article?.publishedTime && (
      <meta property="article:published_time" content={article.publishedTime} />
    )}
    {ogType === 'article' && (article?.modifiedTime || article?.publishedTime) && (
      <meta property="article:modified_time" content={article.modifiedTime ?? article.publishedTime} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    {canonicalUrl && <meta name="twitter:url" content={canonicalUrl} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={SITE.ogImageAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#9a633c" />
    <meta name="color-scheme" content="light" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://imagedelivery.net" />
    <link rel="dns-prefetch" href={`https://${SITE.streamHost}`} />
    <link rel="preload" as="style" href={fontsHref} />
    <link rel="stylesheet" href={fontsHref} />
    <link rel="preload" as="image" href={streamPoster} fetchpriority="high" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:rounded-xl focus:bg-accent-950 focus:px-4 focus:py-3 focus:font-semibold focus:text-white"
    >
      Skip to content
    </a>
    <slot />
    <a
      href="/#acquisition"
      class="fixed inset-x-0 bottom-0 z-50 flex min-h-14 items-center justify-between gap-4 border-t border-white/10 bg-accent-950/95 px-4 py-3 backdrop-blur-md sm:hidden"
      style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
      aria-label={`Inquire about ${SITE.domain} — ${SITE.priceDisplay}`}
    >
      <span class="leading-tight">
        <span class="block text-xs uppercase tracking-widestx text-brand-400">Domain for sale</span>
        <span class="block font-display text-lg font-semibold text-brand-300">{SITE.priceDisplay}</span>
      </span>
      <span class="inline-flex min-h-11 items-center rounded-full bg-brand-500 px-5 text-sm font-medium text-white">
        Inquire
      </span>
    </a>
  </body>
</html>
