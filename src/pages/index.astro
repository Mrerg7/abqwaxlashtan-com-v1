---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const HERO_IMAGE =
  'https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/ff42759f-0014-4f32-6f0b-8d589f17c000/public';
---

<Layout>
  <Header />

  <main class="flex-1">
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-brand-50 to-brand-100/70"></div>
      <div class="container-narrow relative section-padding">
        <div class="grid items-center gap-10 lg:grid-cols-2">
          <div>
            <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white/80 px-4 py-1.5 text-xs font-medium text-brand-700 shadow-sm backdrop-blur">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
              Albuquerque · Wax · Lash · Tan
            </div>
            <h1 class="font-display text-4xl font-semibold tracking-tight text-accent-900 sm:text-5xl lg:text-[3.4rem]">
              ABQ <span class="text-brand-600">Wax Lash Tan</span>
            </h1>
            <p class="mt-6 text-lg leading-relaxed text-accent-600">
              A high-desert studio concept combining hard-wax smoothness, professional lashes, and sun-safe glow —
              services designed for Albuquerque living.
            </p>
            <div class="mt-10 flex flex-col gap-4 sm:flex-row">
              <a href="#services" class="btn-primary">Explore Services</a>
              <a href="#acquisition" class="btn-secondary">Domain Available</a>
            </div>
          </div>

          <figure class="relative">
            <div class="overflow-hidden rounded-3xl border border-brand-100 shadow-xl shadow-brand-200/40">
              <img
                src={HERO_IMAGE}
                alt="ABQ Wax Lash Tan studio wall with gold logo, adobe finish, and desert plants"
                width="1200"
                height="675"
                class="h-full w-full object-cover"
                loading="eager"
                decoding="async"
              />
            </div>
            <figcaption class="mt-3 text-center text-xs text-accent-500">
              Studio concept · Albuquerque, New Mexico
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="services" class="section-padding bg-white">
      <div class="container-narrow">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="font-display text-3xl font-semibold tracking-tight text-accent-900 sm:text-4xl">
            Three Services. One Brand.
          </h2>
          <p class="mt-4 text-lg text-accent-600">
            Complementary treatments that reduce daily maintenance and hold up in a dry, high-altitude climate.
          </p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-3">
          <article class="card">
            <p class="text-xs font-semibold uppercase tracking-widest text-brand-600">Wax</p>
            <h3 class="mt-2 text-xl font-semibold text-accent-900">Hard-wax smoothness</h3>
            <p class="mt-3 text-sm leading-relaxed text-accent-600">
              Wax epilation extracts hair from the root using warm or hard wax, providing smooth skin for 3 to 4 weeks.
              Hard wax is ideal for the bikini line and underarms because it adheres to hair, not skin.
            </p>
          </article>

          <article class="card">
            <p class="text-xs font-semibold uppercase tracking-widest text-brand-600">Lash</p>
            <h3 class="mt-2 text-xl font-semibold text-accent-900">Defined, low-maintenance lashes</h3>
            <p class="mt-3 text-sm leading-relaxed text-accent-600">
              Professional lash work adds shape and definition without daily mascara. A natural fit beside waxing —
              both are appointment-based services that last through busy weeks.
            </p>
          </article>

          <article class="card">
            <p class="text-xs font-semibold uppercase tracking-widest text-brand-600">Tan</p>
            <h3 class="mt-2 text-xl font-semibold text-accent-900">Sun-safe desert glow</h3>
            <p class="mt-3 text-sm leading-relaxed text-accent-600">
              Spray tan delivers color without UV exposure. In Albuquerque’s intense sun, a controlled tan is the safer
              way to look sun-kissed between outdoor days.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="studio" class="section-padding bg-brand-50">
      <div class="container-narrow">
        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div>
            <h2 class="font-display text-3xl font-semibold tracking-tight text-accent-900 sm:text-4xl">
              Built for the high desert
            </h2>
            <p class="mt-4 text-lg text-accent-600">
              Albuquerque clients live with dry air, strong sun, and an active outdoor calendar. The studio concept is
              designed around that reality.
            </p>
            <ul class="mt-8 space-y-4">
              <li class="flex gap-3 text-accent-700">
                <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                </span>
                <span><strong class="font-medium text-accent-900">3–4 weeks of smoothness</strong> from root-extraction waxing.</span>
              </li>
              <li class="flex gap-3 text-accent-700">
                <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                </span>
                <span><strong class="font-medium text-accent-900">Hard wax for sensitive areas</strong> — less skin pull, cleaner release.</span>
              </li>
              <li class="flex gap-3 text-accent-700">
                <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                </span>
                <span><strong class="font-medium text-accent-900">Lash + tan pairing</strong> for events, travel, and summer months.</span>
              </li>
              <li class="flex gap-3 text-accent-700">
                <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                </span>
                <span><strong class="font-medium text-accent-900">Adobe-inspired brand</strong> that reads local the moment a guest walks in.</span>
              </li>
            </ul>
          </div>

          <div class="rounded-3xl border border-brand-100 bg-white p-8 shadow-lg shadow-brand-100/50">
            <div class="space-y-6">
              <div class="flex items-baseline justify-between border-b border-brand-100 pb-4">
                <span class="text-sm font-medium text-accent-500">Wax duration</span>
                <span class="font-display text-2xl font-semibold text-brand-700">3–4 weeks</span>
              </div>
              <div class="flex items-baseline justify-between border-b border-brand-100 pb-4">
                <span class="text-sm font-medium text-accent-500">Ideal hair length</span>
                <span class="font-display text-2xl font-semibold text-brand-700">¼–½ in</span>
              </div>
              <div class="flex items-baseline justify-between border-b border-brand-100 pb-4">
                <span class="text-sm font-medium text-accent-500">Preferred wax</span>
                <span class="font-display text-2xl font-semibold text-brand-700">Hard wax</span>
              </div>
              <div class="flex items-baseline justify-between">
                <span class="text-sm font-medium text-accent-500">Market</span>
                <span class="font-display text-2xl font-semibold text-brand-700">Albuquerque</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="why" class="section-padding bg-white">
      <div class="container-narrow max-w-3xl">
        <h2 class="font-display text-3xl font-semibold tracking-tight text-accent-900 sm:text-4xl">
          Why this name works
        </h2>
        <div class="mt-6 space-y-4 text-accent-700 leading-relaxed">
          <p>
            <strong class="text-accent-900">ABQWaxLashTan.com</strong> packs city, category, and offer into a single
            memorable domain. Searchers looking for waxing, lashes, or spray tan in Albuquerque can land on one brand
            instead of three competing names.
          </p>
          <p>
            The domain is positioned for a boutique studio, a multi-location operator, or a beauty educator targeting
            the New Mexico market. It is available for acquisition.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-brand-100 bg-brand-50/50 py-12">
      <div class="container-narrow text-center">
        <p class="mx-auto max-w-2xl text-sm text-accent-500">
          Information presented reflects widely accepted professional understanding of wax, lash, and spray-tan services
          and is intended solely for educational and demonstration purposes.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
