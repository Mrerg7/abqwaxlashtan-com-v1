---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, ACQUISITION_MAILTO } from '../config/site';
---

<Layout
  title={`Page not found | ${SITE.name}`}
  description={`The page you are looking for does not exist. Return to the ${SITE.name} homepage — ${SITE.domain} is for sale at ${SITE.priceDisplay}.`}
  canonical={false}
  robots="noindex, follow"
>
  <Header />
  <main id="main-content" class="flex-1">
    <section class="container-narrow flex flex-col items-center justify-center py-24 text-center sm:py-32">
      <p class="text-[11px] font-medium uppercase tracking-widestx text-brand-600">Error 404</p>
      <h1 class="mt-4 font-display text-4xl font-semibold text-accent-900 sm:text-5xl">Page not found</h1>
      <p class="mt-4 max-w-md text-sm leading-relaxed text-accent-600 sm:text-base">
        The page you are looking for does not exist or has been moved. Browse the
        <a href="/insights/" class="font-medium text-accent-900 underline decoration-brand-500 underline-offset-4">insights</a>,
        or return to the homepage.
      </p>
      <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a href="/" class="btn-primary">Back to homepage</a>
        <a
          href={ACQUISITION_MAILTO('Domain Inquiry: ABQWaxLashTan.com', `Domain: ${SITE.domain} (asking ${SITE.priceDisplay})`)}
          class="btn-outline"
        >
          Inquire — {SITE.priceDisplay}
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
